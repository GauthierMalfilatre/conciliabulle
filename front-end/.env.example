# Copier en .env.local (git-ignoré) pour le développement.

# URL de l'API Django (backend/), appelée côté serveur Next.js uniquement : le navigateur ne la voit pas.
API_URL=http://localhost:8000/api/v1

# Clé qui signe le cookie de session. OBLIGATOIRE en production (longue chaîne aléatoire :
# python -c "import secrets; print(secrets.token_urlsafe(48))"). Sans elle, valeur de dev.
SESSION_SECRET=

# true = boutons « Comptes de démonstration » sur la page de connexion, même en production
# (toujours visibles en développement). Jamais sur un vrai déploiement.
SHOW_DEMO_ACCOUNTS=false

# 0 = pas de délai simulé sur les parties encore fictives (dossiers, rappels, réglages).
FAKE_LATENCY=0
