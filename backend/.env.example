# Local configuration. Copy to `.env` (git-ignored) and adjust:   cp .env.example .env
# Real environment variables take precedence over this file.

# --- Required ---------------------------------------------------------------
# Django refuses to start without a SECRET_KEY unless DEBUG=true. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
# Never true in production.
DEBUG=true
# Allow `manage.py seed_demo` without DEBUG (accounts with a known password: local runs only).
# DEMO_DATA=false
# Comma-separated host names the API answers to (empty + DEBUG=true allows localhost only).
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Front-end / browsers ---------------------------------------------------
# Origins allowed to call the API from a browser (CORS).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Only for the Django admin served over an HTTPS domain, e.g. https://api.example.org
# CSRF_TRUSTED_ORIGINS=

# --- Database ---------------------------------------------------------------
# sqlite file location (default: backend/db.sqlite3).
# DATABASE_PATH=/data/db.sqlite3

# --- E-mail alerts (default: printed in the console) ------------------------
# Set EMAIL_HOST to send through SMTP.
# EMAIL_HOST=smtp.example.org
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=no-reply@example.org

# --- Production hardening (all optional) ------------------------------------
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000
# BEHIND_HTTPS_PROXY=true   # trust X-Forwarded-Proto from the reverse proxy
